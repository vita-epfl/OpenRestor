{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRestore degradation tracking",
  "type": "object",
  "required": ["recipe_id", "severity", "item_seed", "operations"],
  "properties": {
    "recipe_id": {"type": "string", "minLength": 1},
    "severity": {"type": "string", "minLength": 1},
    "item_seed": {"type": "integer", "minimum": 0},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["primitive", "seed", "summary"],
        "properties": {
          "primitive": {"type": "string", "minLength": 1},
          "variant": {"type": ["string", "null"]},
          "seed": {"type": "integer", "minimum": 0},
          "summary": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
