{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRestore trusted restoration metadata row",
  "type": "object",
  "required": ["id", "degraded_audio_path", "clean_audio_path", "degradation_type", "source_id", "restored_audio_path"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "degraded_audio_path": {"type": "string", "minLength": 1},
    "clean_audio_path": {"type": "string", "minLength": 1},
    "degradation_type": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "restored_audio_path": {"type": "string", "minLength": 1},
    "restored_latent_shape": {"type": ["array", "null"], "items": {"type": "integer"}},
    "duration_sec": {"type": ["number", "null"]},
    "inference_steps": {"type": ["integer", "null"]},
    "batch_time_seconds": {"type": ["number", "null"]},
    "timestamp": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
