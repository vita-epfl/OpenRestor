{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRestore restored-output row",
  "type": "object",
  "required": ["id", "restored_path"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "restored_path": {"type": "string", "minLength": 1},
    "restored_audio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
