{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRestore submission manifest",
  "type": "object",
  "required": ["submission_id", "image", "inference_command"],
  "properties": {
    "submission_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "inference_command": {"type": "string", "minLength": 1},
    "track": {"type": "string", "enum": ["main", "external-data"]}
  },
  "additionalProperties": true
}
